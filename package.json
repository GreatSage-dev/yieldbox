{
  "name": "yield-box",
  "version": "1.0.0",
  "description": "Autonomous cashflow and endowment budget governor for PayBox AI agents.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx src/plugin.ts",
    "build": "esbuild src/plugin.ts --bundle --platform=node --format=esm --target=node24 --minify --outfile=dist/plugin.mjs",
    "conformance": "node scripts/conformance.mjs",
    "test": "node scripts/test.mjs",
    "test:gates": "tsx tests/gates.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "ffmpeg-static": "^5.3.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
